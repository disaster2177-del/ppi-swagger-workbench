# PPI & Swagger Workbench - settings for the service (systemd reads this file).
# After changing anything:  sudo systemctl restart ppi-workbench
# Format: KEY=value, one per line, no quotes, no spaces around "=".

# ---- Web server
PORT=4000
# Empty = all interfaces (other PCs can open the app). 127.0.0.1 = only this machine (e.g. behind nginx).
HOST=
# Settings file (without MongoDB) and the encryption key file live here.
DATA_DIR=/var/lib/ppi-workbench

# Encrypts API credentials saved in Settings. install.sh fills in a random value. Keep it secret;
# changing it makes saved credentials unreadable (enter them again in Settings).
SETTINGS_SECRET_KEY=

# ---- MongoDB (optional)
# Empty = no MongoDB: Settings are saved in DATA_DIR/settings.json, the PPI picture is kept in memory.
# To use MongoDB:  MONGO_URI=mongodb://127.0.0.1:27017/naval_geometry
MONGO_URI=
PERSIST_HISTORY=true
HISTORY_TTL_HOURS=24

# ---- PPI feed
# true  = built-in simulator (demo naval scenario), no Kafka needed
# false = real feed from Kafka (set KAFKA_BROKERS)
PPI_SIMULATOR=true
PPI_SIMULATOR_RATE=1
KAFKA_ENABLED=true
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=naval-geometry-server
KAFKA_GROUP_ID=naval-geometry-ui
KAFKA_TOPICS=radar.geometry,radar.tracks,radar.ownship,radar.legacy-plots:legacyPlot,radar.nmea:nmea0183,ais.nmea:nmea0183,c2.zones

# ---- Live picture
DEFAULT_TTL_SEC=120
TRACK_HISTORY_LENGTH=30
BROADCAST_INTERVAL_MS=200

# ---- API requests sent through the server (Settings > Requests > "The server")
# Outbound proxy, if the server needs one to reach the APIs:
# HTTPS_PROXY=http://proxy.local:3128
# NO_PROXY=localhost,127.0.0.1
NODE_USE_ENV_PROXY=1
# Only allow these target hosts (comma list, *.suffix allowed). Empty = any.
WORKBENCH_ALLOWED_HOSTS=
# Extra CA certificate (PEM) for internal HTTPS APIs:
# NODE_EXTRA_CA_CERTS=/etc/pki/ca-trust/source/anchors/company-ca.pem
