# Copy to .env next to docker-compose.yml and adjust. Used by `docker compose`.

# Required: key that encrypts API credentials saved in Settings.
# Generate one with:  openssl rand -base64 32
SETTINGS_SECRET_KEY=

# Port users open in the browser: http://<vm-address>:APP_PORT
APP_PORT=4000
# Interface to publish on (0.0.0.0 = all; use 127.0.0.1 if a reverse proxy sits in front).
APP_BIND=0.0.0.0
# The address users type, e.g. http://10.20.30.40:4000 or https://ppi.example.internal
PUBLIC_URL=http://localhost:4000

# Outbound proxy for executing APIs, if the VM needs one to reach them.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,mongo,kafka,host.docker.internal

# Optional allow-list for the API request proxy (comma separated, *.suffix allowed). Empty = any host.
WORKBENCH_ALLOWED_HOSTS=

# Optional: path INSIDE the container of an extra CA certificate (see docs/DEPLOY.md).
NODE_EXTRA_CA_CERTS=

# Kafka: publish 9092 beyond the VM (0.0.0.0) and the address remote producers use.
KAFKA_BIND=127.0.0.1
KAFKA_EXTERNAL_HOST=localhost
