# Settings for running WITHOUT Docker (npm start / npm run dev). Copy to server/.env.
# If server/.env does not exist, the server reads the .env in the project root instead.
PORT=4000
# Interface to listen on. Empty = all interfaces (other PCs can connect); 127.0.0.1 = this machine only.
HOST=
# Only needed when the UI runs on its own Vite server (npm run dev:vite on :5173).
CORS_ORIGIN=http://localhost:5173
# Where the server keeps its own files: settings.json (without MongoDB) and settings.key.
# Relative paths are relative to the server folder.
DATA_DIR=.data

# MongoDB (optional)
#   (empty)                                    run without MongoDB: settings in DATA_DIR/settings.json, PPI in memory
#   mongodb://localhost:27017/naval_geometry   use MongoDB (e.g. after "npm run infra"): settings + PPI history kept
MONGO_URI=
# Keep a time-series of every received message (for track replay / history)
PERSIST_HISTORY=true
HISTORY_TTL_HOURS=24

# PPI feed
# true  = built-in simulator feeds the PPI with the demo naval scenario (no Kafka needed)
# false = read the real feed from Kafka (KAFKA_* below, e.g. after "npm run infra")
PPI_SIMULATOR=true
# Simulator updates per second (0.2 - 10)
PPI_SIMULATOR_RATE=1

# Kafka (ignored while PPI_SIMULATOR=true). KAFKA_ENABLED=false = no feed at all.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=naval-geometry-server
KAFKA_GROUP_ID=naval-geometry-ui
# Comma separated list of topic[:adapter]. Adapter defaults to "canonical".
# See server/src/kafka/adapters/index.js for available adapters.
KAFKA_TOPICS=radar.geometry,radar.tracks,radar.ownship,radar.legacy-plots:legacyPlot,radar.nmea:nmea0183,ais.nmea:nmea0183,c2.zones
KAFKA_FROM_BEGINNING=false
# Optional SASL/SSL
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Live picture
# Objects not updated for this many seconds are dropped (0 = never). Per-message "ttlSec" overrides.
DEFAULT_TTL_SEC=120
# Number of past positions kept per track for the trail
TRACK_HISTORY_LENGTH=30
# Socket batching interval (ms) - protects the browser from high Kafka rates
BROADCAST_INTERVAL_MS=200

# OpenAPI workbench
# Key used to encrypt stored API credentials (bearer token, password, API key).
# Use a long random string. If empty, a random key is created in DATA_DIR/settings.key.
SETTINGS_SECRET_KEY=

# Outbound proxy for the API request proxy ("Execute"). Node needs NODE_USE_ENV_PROXY=1 to use these.
# HTTPS_PROXY=http://proxy.corp:3128
# NO_PROXY=localhost,127.0.0.1
# NODE_USE_ENV_PROXY=1
# Only allow these target hosts (comma list, *.suffix allowed). Empty = any.
WORKBENCH_ALLOWED_HOSTS=
